[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Zen Hei")

[sub_resource type="StyleBoxFlat" id="Normal"]
content_margin_left = 22.0
content_margin_top = 12.0
content_margin_right = 22.0
content_margin_bottom = 12.0
bg_color = Color(0.1, 0.16, 0.2, 1)
border_width_left = 2
border_color = Color(0.35, 0.65, 0.7, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[sub_resource type="StyleBoxFlat" id="Hover"]
content_margin_left = 22.0
content_margin_top = 12.0
content_margin_right = 22.0
content_margin_bottom = 12.0
bg_color = Color(0.18, 0.3, 0.34, 1)
border_width_left = 2
border_color = Color(0.8, 0.7, 0.4, 1)

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 24.0
content_margin_top = 24.0
content_margin_right = 24.0
content_margin_bottom = 24.0
bg_color = Color(0.045, 0.07, 0.095, 0.97)

[resource]
default_font = SubResource("Font")
default_font_size = 20
Button/styles/normal = SubResource("Normal")
Button/styles/hover = SubResource("Hover")
Button/styles/pressed = SubResource("Hover")
Button/styles/focus = SubResource("Hover")
Label/colors/font_color = Color(0.87, 0.9, 0.9, 1)
PanelContainer/styles/panel = SubResource("Panel")
VBoxContainer/constants/separation = 12
