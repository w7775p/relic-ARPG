[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://ui/menus/main_menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/menus/settings_panel.tscn" id="2"]
[node name="MainMenu" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.045, 0.065, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Rows" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2

[node name="Title" type="Label" parent="Center/Rows"]
layout_mode = 2
text = "遗物 · 试炼场"
theme_override_font_sizes/font_size = 42
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Rows"]
layout_mode = 2
text = "M2 刷宝原型 / 雷霆旋风"
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="Start" type="Button" parent="Center/Rows"]
layout_mode = 2
text = "新建角色"

[node name="Continue" type="Button" parent="Center/Rows"]
layout_mode = 2
text = "继续探险"

[node name="SettingsButton" type="Button" parent="Center/Rows"]
layout_mode = 2
text = "设置"

[node name="Quit" type="Button" parent="Center/Rows"]
layout_mode = 2
text = "退出"

[node name="Hint" type="Label" parent="Center/Rows"]
layout_mode = 2
text = "左键普攻 · 右键旋风 · I 背包 · E 拾取"
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="Settings" parent="." instance=ExtResource("2")]
visible = false

[connection signal="pressed" from="Center/Rows/Start" to="." method="_on_start_pressed"]

[connection signal="pressed" from="Center/Rows/Continue" to="." method="_on_continue_pressed"]

[connection signal="pressed" from="Center/Rows/SettingsButton" to="." method="_on_settings_pressed"]

[connection signal="pressed" from="Center/Rows/Quit" to="." method="_on_quit_pressed"]
