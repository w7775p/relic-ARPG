[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/hub/backpack/backpack_page.gd" id="1"]

[node name="BackpackPage" type="PanelContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Summary" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "据点整备"

[node name="Top" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Rows/Top"]
layout_mode = 2
size_flags_horizontal = 3
text = "背包"

[node name="Close" type="Button" parent="Margin/Rows/Top"]
layout_mode = 2
text = "关闭（I / Esc）"

[node name="Columns" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3

[node name="Items" type="ItemList" parent="Margin/Rows/Columns"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 3

[node name="Left" type="ScrollContainer" parent="Margin/Rows/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="LeftText" type="Label" parent="Margin/Rows/Columns/Left"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2

[node name="Right" type="ScrollContainer" parent="Margin/Rows/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="RightText" type="Label" parent="Margin/Rows/Columns/Right"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2

[node name="Actions" type="HFlowContainer" parent="Margin/Rows"]
layout_mode = 2

[node name="Equip" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "穿戴"

[node name="Lock" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "锁定 / 解锁"

[node name="Store" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "存入仓库"

[node name="Sell" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "出售"

[node name="Salvage" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "拆解"

[node name="Reforge" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "重铸"

[node name="Depart" type="Button" parent="Margin/Rows/Actions"]
layout_mode = 2
text = "出发"

[node name="Filter" type="Button" parent="Margin/Rows/Actions"]
