[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://ui/menus/settings_panel.gd" id="1"]
[node name="Settings" type="PanelContainer"]
process_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -240.0
offset_right = 240.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "设置"
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[node name="VolumeLabel" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "总音量"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[node name="Volume" type="HSlider" parent="Margin/Rows"]
layout_mode = 2
max_value = 1.0
step = 0.01
value = 0.7

[node name="Fullscreen" type="CheckButton" parent="Margin/Rows"]
layout_mode = 2
text = "全屏显示"

[node name="Test" type="Button" parent="Margin/Rows"]
layout_mode = 2
text = "试听音量"

[node name="Status" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "设置自动保存"
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="Close" type="Button" parent="Margin/Rows"]
layout_mode = 2
text = "返回"

[connection signal="value_changed" from="Margin/Rows/Volume" to="." method="_on_volume_value_changed"]

[connection signal="toggled" from="Margin/Rows/Fullscreen" to="." method="_on_fullscreen_toggled"]

[connection signal="pressed" from="Margin/Rows/Test" to="." method="_on_test_pressed"]

[connection signal="pressed" from="Margin/Rows/Close" to="." method="_on_close_pressed"]
